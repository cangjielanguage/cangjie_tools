{"jsonrpc":"2.0","method":"textDocument/didOpen","params":{"textDocument":{"uri":"file:///d%3A/Project/Cangjie/lsp-server/dev/lsp/test/testChr/refactor/src/IntroduceParameter/introduce_parameter.cj","languageId":"Cangjie","version":1,"text":"// Copyright (c) Huawei Technologies Co., Ltd. 2025. All rights reserved.\r\n// This source file is part of the Cangjie project, licensed under Apache-2.0\r\n// with Runtime Library Exception.\r\n//\r\n// See https://cangjie-lang.cn/pages/LICENSE for license information.\r\n\r\n/**\r\n * Created on 2025/7/17\r\n */\r\npackage ohos_app_cangjie_entry.IntroduceParameter\r\n\r\nfunc introduceParameterSample(base: Int64) {\r\n    var value = base + 1\r\n}\r\n\r\nfunc multiParamSum(a: Int64, b: Int64, c: Int64, d: Int64, e: Int64): Int64 {\r\n    a + 1 + b + c + d + e + 7\r\n}\r\n\r\nfunc callIntroduceParameterSample() {\r\n    introduceParameterSample(10)\r\n}\r\n\r\nfunc localReferenceParameter(base: Int64): Int64 {\r\n    let delta = 2\r\n    return base + delta\r\n}\r\n\r\nfunc twoOriginalParameters(left: Int64, right: Int64): Int64 {\r\n    return left + right\r\n}\r\n\r\nfunc literalParameterSample(): Float64 {\r\n    return 0.9 + 12.1\r\n}\r\n\r\nfunc localOnlyExpression(): Int64 {\r\n    let left = 1\r\n    let right = 2\r\n    return left + right\r\n}\r\n\r\nfunc mixedParams(a: Int64, b!: Int64, c!: Int64): Int64 {\r\n    a + b + c\r\n}\r\n\r\npublic func testMixedParams(): Unit {\r\n    let r1 = mixedParams(1, b: 10, c: 100)\r\n    let r2 = mixedParams(2, c: 200, b: 20)\r\n\r\n    println(\"Mixed param test: ${r1}, ${r2}\")\r\n}\r\n\r\n\r\nopen class Animal2 {\r\n    var name: String\r\n\r\n    init(name: String) {\r\n        this.name = name\r\n    }\r\n\r\n    func speak() {\r\n        println(\"${this.name} speaks\")\r\n    }\r\n\r\n    public open func getInfo(): String {\r\n        return \"Animal: ${this.name}\"\r\n    }\r\n}\r\n\r\nclass Dog <: Animal2 {\r\n    init(name: String) {\r\n        super(name)\r\n    }\r\n\r\n    public override func getInfo(): String {\r\n        return \"Dog: ${this.name}\"\r\n    }\r\n}\r\n\r\nfunc main1() {\r\n    let dog = Dog(\"??\")\r\n    dog.speak()\r\n    println(dog.getInfo())\r\n}\r\n\r\n\r\nfunc greet(name!: String = \"World\", greeting!: String = \"Hello\"): String {\r\n    \"${greeting}, ${name}!\"\r\n    \"test\" + name\r\n}\r\n\r\npublic func testDefaultValue(): Unit {\r\n    let r1 = greet()\r\n    let r2 = greet(name: \"Cangjie\")\r\n}\r\n\r\nfunc compoundAssignSample(a: Int64): Unit {\r\n    a += 2\r\n    a -= 2\r\n    a <<= 2\r\n    a ^= 2\r\n}\r\n\r\nfunc callCompoundAssignSample(): Unit {\r\n    var value: Int64 = 10\r\n    compoundAssignSample(value)\r\n}\r\n\r\nfunc bitCompoundAssignSample(): Unit {\r\n    var bit: Int32 = 0b0001\r\n    bit >>= 1\r\n    bit |= 0b1000\r\n    bit &= 0b1111\r\n    bit ^= 0b1111\r\n}\r\n\r\nfunc outer(a: Int64): Int64 {\r\n    func inner(b: Int64): Int64 {\r\n        b * 2\r\n    }\r\n    inner(a) + 1\r\n}\r\n\r\npublic func testNestedFunction(): Unit {\r\n    let result = outer(10)\r\n    println(\"outer(10) = ${result}\")\r\n}\r\n\r\nenum RGBColor {\r\n| Red(UInt8)\r\n| Green(UInt8)\r\n| Blue(UInt8)\r\n\r\n    public func getValue(): UInt8 {\r\n        var a = 9\r\n        let color = RGBColor.Red(200)\r\n        match (this) {\r\n            case Red(v) => v\r\n            case Green(v) => v\r\n            case Blue(v) => v\r\n        }\r\n    }\r\n\r\n    public func next(base: Int64): Int64 {\r\n        return base + 8\r\n    }\r\n}\r\n\r\nfunc main3() {\r\n    let color = RGBColor.Red(200)\r\n    var aa = color.next(8)\r\n    var aa1 = color.getValue()\r\n    println(\"红色值: ${color.getValue()}\")\r\n}\r\n"}}}
